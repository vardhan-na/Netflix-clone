pipeline {
    agent any

    options {
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        // Exposes DOCKERHUB_CREDS_USR and DOCKERHUB_CREDS_PSW
        DOCKERHUB_CREDS = credentials('dockerhub-creds')
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/vardhan-na/Netflix-clone.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'yarn install --frozen-lockfile'
            }
        }

        stage('Sonarqube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '''
                        sonar-scanner \
                        -Dsonar.projectName=Netflix-clone \
                        -Dsonar.projectKey=Netflix-clone \
                        -Dsonar.sources=src
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                // Needs the SonarQube -> Jenkins webhook, otherwise this waits until the timeout
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate(
                        abortPipeline: true,
                        credentialsId: 'sonar-token'
                    )
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'nvd-api-key',
                        variable: 'NVD_API_KEY'
                    )
                ]) {
                    dependencyCheck(
                        additionalArguments: """
                            --scan ./
                            --format ALL
                            --disableYarnAudit
                            --disableNodeAudit
                            --nvdApiKey $NVD_API_KEY
                            --nvdValidForHours 24
                        """,
                        odcInstallation: 'DP-Check'
                    )
                }

                dependencyCheckPublisher(
                    pattern: '**/dependency-check-report.xml'
                )
            }
        }

        stage('Trivy FS Scan') {
            steps {
                // Report only; change --exit-code to 1 to make filesystem findings fail the build
                sh '''
                    trivy fs \
                        --severity HIGH,CRITICAL \
                        --exit-code 0 \
                        --output trivyfs.txt \
                        .
                '''
            }
        }

        stage('Docker Build') {
            steps {
                withCredentials([string(credentialsId: 'tmdb-api-key', variable: 'TMDB_KEY')]) {
                    sh '''
                        docker build \
                            --build-arg TMDB_V3_API_KEY="$TMDB_KEY" \
                            -t "$DOCKERHUB_CREDS_USR/netflix-clone:${BUILD_NUMBER}" .
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                // Runs BEFORE push: HIGH/CRITICAL fixable vulns fail the build,
                // so a vulnerable image never reaches Docker Hub
                sh '''
                    trivy image \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        --exit-code 1 \
                        --output trivyimage.txt \
                        "$DOCKERHUB_CREDS_USR/netflix-clone:${BUILD_NUMBER}"
                '''
            }
        }

        stage('Docker Push') {
            steps {
                sh '''
                    echo "$DOCKERHUB_CREDS_PSW" | docker login \
                        -u "$DOCKERHUB_CREDS_USR" \
                        --password-stdin

                    docker push \
                        "$DOCKERHUB_CREDS_USR/netflix-clone:${BUILD_NUMBER}"
                '''
            }
        }

        stage('Update Helm values.yaml') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-creds',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_PASS'
                    )
                ]) {
                    sh '''
                        set -e

                        # Temporary askpass helper so the token never appears in a URL
                        ASKPASS="$(mktemp)"
                        trap 'rm -f "$ASKPASS"' EXIT
                        printf '#!/bin/sh\\ncase "$1" in\\n  Username*) echo "$GIT_USER" ;;\\n  *) echo "$GIT_PASS" ;;\\nesac\\n' > "$ASKPASS"
                        chmod 700 "$ASKPASS"
                        export GIT_ASKPASS="$ASKPASS"
                        export GIT_TERMINAL_PROMPT=0

                        # Update only the tag line, keeping indentation
                        sed -i -E "s/^([[:space:]]*tag:).*/\\1 \\"${BUILD_NUMBER}\\"/" \
                            helm/netflix-app-chart/values.yaml

                        git config user.email "jenkins@your-domain.com"
                        git config user.name "Jenkins CI"

                        git add helm/netflix-app-chart/values.yaml

                        # Commit only if something changed; real errors are not swallowed
                        git diff --cached --quiet || \
                            git commit -m "Update image tag to ${BUILD_NUMBER} [skip ci]"

                        # Pick up any commits pushed while this build was running
                        git fetch origin main
                        git rebase origin/main

                        git push origin HEAD:main
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'trivyfs.txt,trivyimage.txt,dependency-check-report.html,dependency-check-report.xml',
                allowEmptyArchive: true
            )
            sh '''
                docker logout || true
                docker rmi "$DOCKERHUB_CREDS_USR/netflix-clone:${BUILD_NUMBER}" || true
                docker image prune -f || true
            '''
        }
    }
}
